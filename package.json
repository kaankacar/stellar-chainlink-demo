{
  "name": "stellar-chainlink-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Two Clocks: Chainlink Data Feeds (push) and Data Streams (pull) prices read, verified and compared in a Soroban contract on Stellar testnet. Field Note No. 03.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build:wasm": "cd contracts/two-clocks && stellar contract build",
    "recon": "tsx --tsconfig tsconfig.node.json scripts/recon.ts",
    "deploy": "tsx --tsconfig tsconfig.node.json scripts/deploy.ts",
    "refresh": "tsx --tsconfig tsconfig.node.json scripts/refresh.ts",
    "submit": "tsx --tsconfig tsconfig.node.json scripts/submit.ts",
    "watch": "tsx --tsconfig tsconfig.node.json scripts/watch.ts",
    "verify-raw": "tsx --tsconfig tsconfig.node.json scripts/verify-raw.ts",
    "read-feed": "tsx --tsconfig tsconfig.node.json scripts/read-feed.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^17.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "globals": "^16.0.0",
    "puppeteer-core": "25.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.3.4",
    "vitest": "^3.2.0"
  }
}
