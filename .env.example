# Chainlink Data Streams credentials from the Chainlink Platform (app.chain.link, Data Streams, Credentials).
# Mainnet and testnet credentials are separate. The ones below are environment-specific.
DATA_STREAMS_USERNAME=
DATA_STREAMS_SECRET=
# Candlestick API password (same username, different secret).
CANDLESTICK_API_KEY=
# Testnet signer for deploy, refresh, submit and watch. Leave empty to use a throwaway friendbot key.
STELLAR_SECRET=
